# ==============================================================================
# Joseph Akinwole Portfolio — Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# In production (e.g. Vercel, Netlify, Cloud Run), add these variables
# directly in your project settings dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Admin Authentication & Session Security
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JWT admin session cookies.
# Recommended: generate a 64-char random string via: openssl rand -base64 32
ADMIN_JWT_SECRET=mon-portfolio-joseph-admin-secret-2026-secure-key-replace-in-production

# ------------------------------------------------------------------------------
# 2. DEV.to API Integration
# ------------------------------------------------------------------------------
# The DEV.to username whose published articles will be synced and displayed.
DEVTO_USERNAME=joebim

# DEV.to API Key (https://dev.to/settings/extensions -> DEV Community API Keys)
# Required for programmatic publishing / cross-posting from portfolio admin.
DEVTO_API_KEY=

# ------------------------------------------------------------------------------
# 3. Medium API Integration
# ------------------------------------------------------------------------------
# Integration token to automatically publish / cross-post articles to Medium.
# Get token: Medium -> Settings -> Security and apps -> Integration tokens -> Get integration token
MEDIUM_INTEGRATION_TOKEN=
MEDIUM_AUTHOR_NAME="Joseph Akinwole"

# ------------------------------------------------------------------------------
# 4. Google Cloud Firestore / Firebase Admin SDK (Server-Side Cloud Backend)
# ------------------------------------------------------------------------------
# When connecting to Firebase / Cloud Firestore:
# 1. Go to Firebase Console -> Project Settings -> Service Accounts
# 2. Click "Generate new private key" to download the JSON service account file.
# 3. Copy the values below from the downloaded JSON file:
FIREBASE_PROJECT_ID=mon-portfolio-a069b
FIREBASE_CLIENT_EMAIL=
# Note: Keep the newlines escaped as \n if entered as a single-line string
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 5. Firebase Client SDK (Browser-Side Authentication)
# ------------------------------------------------------------------------------
# Used in the browser for Firebase Auth (Google Sign-In, Email/Password)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mon-portfolio-a069b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mon-portfolio-a069b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mon-portfolio-a069b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=214053569519
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 6. Cloudinary Image Management
# ------------------------------------------------------------------------------
# Used to upload and serve optimized images for blogs and project works.
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional full connection URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ------------------------------------------------------------------------------
# 7. Public Site URL
# ------------------------------------------------------------------------------
# Used for canonical URL generation, Medium canonical links, and sitemaps.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
